import { DataTypes, Model } from "sequelize";
import sequelize from "../config/database.js";

class tbGym extends Model {};

tbGym.init(
        {
        // Attributs ici
        gymId : {
            type : DataTypes.INTEGER,
            primaryKey: true,
            autoIncrement:true
        },
        gymName :{
            type : DataTypes.STRING,
            allowNull: false,
        },
        gymAddress :{
            type : DataTypes.STRING,
            allowNull: false,
        },
        gymSchedule :{
            type : DataTypes.JSON,
            allowNull: false,
        },
                areaImageUrl: {
        type: DataTypes.STRING,
        allowNull: true,
        }
    },
    {
        //les options de la table ici (model)
        sequelize, //need to pass the connection instance
        modelName: 'tbGym',// Nom de la table 
    },
);

export default tbGym