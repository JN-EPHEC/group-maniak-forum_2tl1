{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",

    "rootDir": "./src",
    "outDir": "./dist",

    "lib": ["es2022"],
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "strict": true,
    "skipLibCheck": true,

    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    "typeRoots": ["./src/types", "./node_modules/@types"]
  },

  "exclude": [
    "node_modules",
    "dist",
    "src/tests",
    "**/*.test.ts",
    ".env"
  ]
}
